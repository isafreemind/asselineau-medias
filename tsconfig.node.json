{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "scripts/**/*.ts", "src/schema.ts"]
}
